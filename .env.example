# SilverScape Solutions — environment variables
# Copy to .env for local development. In production, set these in
# Netlify → Site configuration → Environment variables.
# VITE_* values are public (bundled into the browser). Everything else is server-only.

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Falls back to Netlify's URL at build time.
# Without either, canonical and og:url tags are omitted.
VITE_SITE_URL=https://www.example.com

# ── Analytics (public IDs; scripts load only when set) ───────────────
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# ── Sod ordering: Google Maps Platform (server-only) ─────────────────
# Enable "Geocoding API" and "Routes API" on this key. Restrict by API, not by referrer.
GOOGLE_MAPS_API_KEY=
# Route start/end and farm pickup. Defaults shown — confirm the farm address with the owner.
SOD_BASE_ADDRESS=189 Stephanie Drive, Guelph, ON, Canada
SOD_FARM_ADDRESS=Greenhorizons Sod Farms, 1625 Kossuth Road, Cambridge, ON N3H 4R6, Canada
# Optional: refuse online orders whose full route exceeds this many km.
SOD_MAX_ROUTE_KM=

# ── Sod ordering: Stripe Checkout (server-only) ──────────────────────
# Use sk_test_… for previews and sk_live_… for production.
# A live key is refused while launch blockers remain in src/lib/legal.ts
# (business premises address, HST confirmation, undecided sod delivery rules) or while order
# confirmation emails are not configured.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe-webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
# Needed to email customers a written copy of their order.
STRIPE_WEBHOOK_SECRET=

# ── Quote form delivery (server-only; configure Resend and/or webhook) ─
RESEND_API_KEY=
# One or more comma-separated recipients.
LEAD_NOTIFICATION_EMAIL=silverscapesolutions@gmail.com
# Must be on a domain verified in Resend. onboarding@resend.dev only works for testing.
# Also the sender of sod order confirmation emails.
LEAD_FROM_EMAIL=
# Optional: POST each lead as JSON to a CRM/Zapier/Make endpoint.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
